# VALORES FICTÍCIOS - este arquivo é apenas um modelo e pode ser versionado.
# Copie para ".env" (que o Git ignora), preencha localmente e NUNCA faça commit do ".env".
# Hoje o núcleo lê apenas NEXUS_HOME; as demais variáveis são reservadas para as etapas 8 e 9.

# Pasta de dados locais (opcional). Vazio = padrão do sistema.
NEXUS_HOME=

# --- Reservado: sincronização online (etapa 8) ---
# Somente a chave PÚBLICA (anon) com RLS pode existir em um cliente.
# A chave service_role e quaisquer chaves de assinatura NUNCA entram no aplicativo nem no Git.
NEXUS_SUPABASE_URL=https://example-project.supabase.co
NEXUS_SUPABASE_ANON_KEY=preencha-localmente

# --- Reservado: licenciamento (etapa 8) ---
NEXUS_LICENSE_API_URL=https://licenses.example.invalid/v1
