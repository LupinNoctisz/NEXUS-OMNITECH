<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Claro: branco/cinza muito claro, mesmo azul de destaque -->
    <SolidColorBrush x:Key="BgBrush" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LineBrush" Color="#D5DCE5"/>
    <SolidColorBrush x:Key="TextBrush" Color="#16202B"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5B6B7B"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#1F6FEB"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#0E8A9B"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E9EEF5"/>
    <SolidColorBrush x:Key="OkBrush" Color="#1A7F37"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#9A6700"/>
    <SolidColorBrush x:Key="CritBrush" Color="#CF222E"/>
</ResourceDictionary>
